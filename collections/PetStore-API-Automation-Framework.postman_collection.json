	"item": [
		{
			"name": "Pet Creation",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const response=pm.response.json();\r",
							"console.log(response);\r",
							"\r",
							"//pm.collectionVariables.set(\"currentPetId\", pm.iterationData.get(\"petId\"));\r",
							"const petSchema = {\r",
							"    \"type\": \"object\",\r",
							"    \"required\": [\"id\", \"name\", \"status\"],\r",
							"    \"properties\": {\r",
							"        \"id\": {\r",
							"            \"type\": \"integer\"\r",
							"        },\r",
							"        \"name\": {\r",
							"            \"type\": \"string\"\r",
							"        },\r",
							"        \"status\": {\r",
							"            \"type\": \"string\"\r",
							"        }\r",
							"    }\r",
							"};\r",
							"\r",
							"pm.test(\"Schema Validation\", function () {\r",
							"    pm.response.to.have.jsonSchema(petSchema);\r",
							"});\r",
							"\r",
							"pm.test(\"Pet creation or post data successfull\", function(){\r",
							"    pm.expect(response.id).equal(Number(pm.environment.get(\"petId\")));\r",
							"} );\r",
							"\r",
							"pm.test( \"Response status to be 200\", function(){\r",
							"    pm.response.to.have.status(200);\r",
							"}\r",
							");\r",
							"\r",
							"pm.test(\"response time to be under 2sec\",function(){\r",
							"\r",
							"pm.expect(pm.response.responseTime).to.be.below(2000)\r",
							"\r",
							"});\r",
							"\r",
							"\r",
							"\r",
							""
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"\r",
							"\r",
							"    pm.environment.set(\r",
							"       \"petId\", Math.floor(Math.random()*1000)\r",
							"    );\r",
							""
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"id\":{{petId}},\r\n  \"name\": \"dens\",\r\n  \"status\": \"available\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/api/v3/pet",
